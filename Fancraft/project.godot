; Engine configuration file.
config_version=5

[application]

config/name="Fancraft"
config/description="Free-form voxel sandbox with parallax-mapped materials."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.1, 0.14, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Blocks="*res://scripts/world/blocks.gd"
Textures="*res://scripts/textures/texture_library.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/frame_pacing/android/enable_frame_pacing=false

[input_devices]

pointing/emulate_mouse_from_touch=false

[threading]

worker_pool/low_priority_thread_ratio=0.6

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.9, 1)
